[Unit]
Description=Albireo experimental node
Documentation=https://github.com/sanctumsecopsmssp/albireo-open-source
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=albireo
Group=albireo
ExecStart=/usr/local/bin/albireo serve --config /etc/albireo/albireo.yaml
ExecStartPre=/usr/local/bin/albireo version
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/albireo
ReadOnlyPaths=/etc/albireo
StateDirectory=albireo
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
